LOCATE COMP "sd_dat3" SITE "M14";
IOBUF  PORT "sd_dat3" IO_TYPE=LVCMOS33 PULLMODE=UP SLEWRATE=SLOW;
LOCATE COMP "sd_clk" SITE "P15";
IOBUF  PORT "sd_clk" IO_TYPE=LVCMOS33 PULLMODE=NONE SLEWRATE=SLOW;
LOCATE COMP "sd_cmd" SITE "N16";
IOBUF  PORT "sd_cmd" IO_TYPE=LVCMOS33 PULLMODE=UP SLEWRATE=SLOW;
LOCATE COMP "sd_det" SITE "M16";
IOBUF  PORT "sd_det" IO_TYPE=LVCMOS33 PULLMODE=UP SLEWRATE=SLOW;

# USB
LOCATE COMP "usb_dp[0]" SITE "F15";
IOBUF  PORT "usb_dp[0]" IO_TYPE=LVCMOS33 DRIVE=4 PULLMODE=NONE;
LOCATE COMP "usb_dn[0]" SITE "E16";
