IOBUF  PORT "gpio[17]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "mcu_ss" SITE "N4"; # 12
IOBUF  PORT "mcu_ss" IO_TYPE=LVCMOS33 PULLMODE=UP;
