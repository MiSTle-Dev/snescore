IOBUF  PORT "gpio[15]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "gpio[16]" SITE "H3"; # 36
IOBUF  PORT "gpio[16]" IO_TYPE=LVCMOS33 PULLMODE=UP;
