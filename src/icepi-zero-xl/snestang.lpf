# SPI Flash
LOCATE COMP "flash_spi_cs_n" SITE "N8";
IOBUF  PORT "flash_spi_cs_n" IO_TYPE=LVCMOS33 PULLMODE=UP ;
LOCATE COMP "flash_spi_mosi" SITE "T8";
IOBUF  PORT "flash_spi_mosi" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
LOCATE COMP "flash_spi_miso" SITE "T7";
IOBUF  PORT "flash_spi_miso" IO_TYPE=LVCMOS33 PULLMODE=NONE ;
LOCATE COMP "flash_spi_wp_n" SITE "M7";
IOBUF  PORT "flash_spi_wp_n" IO_TYPE=LVCMOS33 PULLMODE=DOWN ;
LOCATE COMP "flash_spi_hold_n" SITE "N7";
IOBUF  PORT "flash_spi_hold_n" IO_TYPE=LVCMOS33 PULLMODE=DOWN ;

# fake clock tristate to prevent synplify to optimize this away
LOCATE COMP "flash_spi_clk_ts" SITE "D12";
IOBUF  PORT "flash_spi_clk_ts" IO_TYPE=LVCMOS33 PULLMODE=DOWN;

# https://www.latticesemi.com/en/Support/AnswerDatabase/1/9/6/1964
BLOCK RESETPATHS;
BLOCK ASYNCPATHS;

# Period Constraints
FREQUENCY NET "fclk" 85.7143 MHz ;
FREQUENCY NET "mclk" 21.4286 MHz ;
FREQUENCY NET "hclk" 74.1744 MHz ;
FREQUENCY NET "hclk5" 370.872 MHz ;
FREQUENCY NET "uclk" 60.000 MHz ;

BLOCK PATH FROM CLKNET "fclk" TO CLKNET "hclk";
BLOCK PATH FROM CLKNET "fclk" TO CLKNET "hclk5";
BLOCK PATH FROM CLKNET "fclk" TO CLKNET "uclk";

BLOCK PATH FROM CLKNET "mclk" TO CLKNET "hclk";
BLOCK PATH FROM CLKNET "mclk" TO CLKNET "hclk5";
BLOCK PATH FROM CLKNET "mclk" TO CLKNET "uclk";

BLOCK PATH FROM CLKNET "hclk" TO CLKNET "fclk";
BLOCK PATH FROM CLKNET "hclk" TO CLKNET "mclk";
BLOCK PATH FROM CLKNET "hclk" TO CLKNET "uclk";

BLOCK PATH FROM CLKNET "hclk5" TO CLKNET "fclk";
BLOCK PATH FROM CLKNET "hclk5" TO CLKNET "mclk";
BLOCK PATH FROM CLKNET "hclk5" TO CLKNET "uclk";

BLOCK PATH FROM CLKNET "uclk" TO CLKNET "fclk";
BLOCK PATH FROM CLKNET "uclk" TO CLKNET "mclk";
BLOCK PATH FROM CLKNET "uclk" TO CLKNET "hclk";
BLOCK PATH FROM CLKNET "uclk" TO CLKNET "hclk5";

MULTICYCLE FROM CLKNET "mclk" TO CLKNET "fclk" 3X ;
MULTICYCLE FROM CLKNET "fclk" TO CLKNET "mclk" 3X_SOURCE ;

BLOCK PATH TO CELL "*packet_picker/audio_clock_regeneration_packet/clk_audio_counter_wrap_synchronizer_chain*" ;
BLOCK PATH FROM CELL "*packet_picker/audio_sample_word_transfer*" ;

BLOCK PATH FROM CELL "*smc/ram_mask*" ;
BLOCK PATH FROM CELL "*smc/ram_size*" ;
BLOCK PATH FROM CELL "*smc/rom_mask*" ;
BLOCK PATH FROM CELL "*smc/rom_size*" ;
BLOCK PATH FROM CELL "*smc/rom_type*" ;

CLOCK_TO_OUT PORT "O_sdram_cs_n*" OUTPUT_DELAY 1.5 ns MIN 0.8 ns CLKNET "clk_sys" CLKOUT PORT "O_sdram_clk" CLK_OFFSET 0.5 X ;
CLOCK_TO_OUT PORT "O_sdram_addr*" OUTPUT_DELAY 1.5 ns MIN 0.8 ns CLKNET "clk_sys" CLKOUT PORT "O_sdram_clk" CLK_OFFSET 0.5 X ;
CLOCK_TO_OUT PORT "IO_sdram_dq*" OUTPUT_DELAY 1.5 ns MIN 0.8 ns CLKNET "clk_sys" CLKOUT PORT "O_sdram_clk" CLK_OFFSET 0.5 X ;
CLOCK_TO_OUT PORT "O_sdram_wen_n*" OUTPUT_DELAY 1.5 ns MIN 0.8 ns CLKNET "clk_sys" CLKOUT PORT "O_sdram_clk" CLK_OFFSET 0.5 X ;
CLOCK_TO_OUT PORT "O_sdram_ras_n*" OUTPUT_DELAY 1.5 ns MIN 0.8 ns CLKNET "clk_sys" CLKOUT PORT "O_sdram_clk" CLK_OFFSET 0.5 X ;
CLOCK_TO_OUT PORT "O_sdram_cas_n*" OUTPUT_DELAY 1.5 ns MIN 0.8 ns CLKNET "clk_sys" CLKOUT PORT "O_sdram_clk" CLK_OFFSET 0.5 X ;
CLOCK_TO_OUT PORT "O_sdram_cke*" OUTPUT_DELAY 1.5 ns MIN 0.8 ns CLKNET "clk_sys" CLKOUT PORT "O_sdram_clk" CLK_OFFSET 0.5 X ;
CLOCK_TO_OUT PORT "O_sdram_ba*" OUTPUT_DELAY 1.5 ns MIN 0.8 ns CLKNET "clk_sys" CLKOUT PORT "O_sdram_clk" CLK_OFFSET 0.5 X ;
CLOCK_TO_OUT PORT "O_sdram_dqm*" OUTPUT_DELAY 1.5 ns MIN 0.8 ns CLKNET "clk_sys" CLKOUT PORT "O_sdram_clk" CLK_OFFSET 0.5 X ;
