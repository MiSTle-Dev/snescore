IOBUF  PORT "tmds_d_n[1]" IO_TYPE=LVCMOS33D DRIVE=4;
LOCATE COMP "tmds_d_p[2]" SITE "P16"; # Red
IOBUF  PORT "tmds_d_p[2]" IO_TYPE=LVCMOS33D DRIVE=4;
LOCATE COMP "tmds_d_n[2]" SITE "R16";
IOBUF  PORT "tmds_d_n[2]" IO_TYPE=LVCMOS33D DRIVE=4;
LOCATE COMP "tmds_clk_p" SITE "R12"; # Clock
IOBUF  PORT "tmds_clk_p" IO_TYPE=LVCMOS33D DRIVE=4;
LOCATE COMP "tmds_clk_n" SITE "T13";
IOBUF  PORT "tmds_clk_n" IO_TYPE=LVCMOS33D DRIVE=4;

# SD Card
LOCATE COMP "sd_dat0" SITE "P14";
IOBUF  PORT "sd_dat0" IO_TYPE=LVCMOS33 PULLMODE=UP SLEWRATE=SLOW;
LOCATE COMP "sd_dat1" SITE "R14";
