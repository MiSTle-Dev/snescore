LOCATE COMP "mcu_intn" SITE "P2"; # 15
IOBUF  PORT "mcu_intn" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "gpio[23]" SITE "M2"; # 16
IOBUF  PORT "gpio[23]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "mcu_clk" SITE "L1"; # 18
IOBUF  PORT "mcu_clk" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "mcu_din" SITE "J2"; # 22
IOBUF  PORT "mcu_din" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "gpio[26]" SITE "D4"; # 37
IOBUF  PORT "gpio[26]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "gpio[27]" SITE "P3"; # 13
IOBUF  PORT "gpio[27]" IO_TYPE=LVCMOS33 PULLMODE=UP;

# LEDs
LOCATE COMP "led[0]" SITE "E13";
IOBUF  PORT "led[0]" IO_TYPE=LVCMOS33 PULLMODE=DOWN DRIVE=4;
LOCATE COMP "led[1]" SITE "D14";
IOBUF  PORT "led[1]" IO_TYPE=LVCMOS33 PULLMODE=DOWN DRIVE=4;
