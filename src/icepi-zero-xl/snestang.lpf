LOCATE COMP "s1_n" SITE "C5";
IOBUF  PORT "s1_n" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;

# GPDI
LOCATE COMP "tmds_d_p[0]" SITE "R13"; # Blue
IOBUF  PORT "tmds_d_p[0]" IO_TYPE=LVCMOS33D DRIVE=4;
LOCATE COMP "tmds_d_n[0]" SITE "T14";
IOBUF  PORT "tmds_d_n[0]" IO_TYPE=LVCMOS33D DRIVE=4;
LOCATE COMP "tmds_d_p[1]" SITE "R15"; # Green
