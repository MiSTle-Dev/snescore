SYSCONFIG CONFIG_IOVOLTAGE=3.3 COMPRESS_CONFIG=ON MCCLK_FREQ=62 MASTER_SPI_PORT=DISABLE SLAVE_SPI_PORT=DISABLE SLAVE_PARALLEL_PORT=DISABLE;

# Clock
LOCATE COMP "sys_clk" SITE "M1";
IOBUF  PORT "sys_clk" IO_TYPE=LVCMOS33 PULLMODE=NONE;
FREQUENCY PORT "sys_clk" 50 MHZ;

# FTDI
LOCATE COMP "UART_TXD" SITE "K15"; # Transmit to ftdi
IOBUF  PORT "UART_TXD" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "UART_RXD" SITE "K16"; # Transmit from ftdi
IOBUF  PORT "UART_RXD" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "UART_RTSN" SITE "L16";
IOBUF  PORT "UART_RTSN" IO_TYPE=LVCMOS33 DRIVE=4 PULLMODE=DOWN;
LOCATE COMP "UART_DTRN" SITE "L15";
IOBUF  PORT "UART_DTRN" IO_TYPE=LVCMOS33 DRIVE=4 PULLMODE=DOWN;

# GPIOs, use for js0 and js1
LOCATE COMP "gpio[0]" SITE "G3"; # 27
IOBUF  PORT "gpio[0]" IO_TYPE=LVCMOS33 PULLMODE=UP;
